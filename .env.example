DB_HOST=your-mysql-host
DB_PORT=3307
DB_USER=farbio_app
DB_PASSWORD=replace-with-a-dedicated-database-password
DB_NAME=farbiopharma_logistica

# Generate a unique random secret for Flask session signing.
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-bytes

# Exact origin serving the NAVEW frontend; no trailing slash.
NAVEW_FRONTEND_ORIGIN=http://localhost:5173

# Set true in HTTPS deployments. False is only suitable for local HTTP development.
SESSION_COOKIE_SECURE=false
